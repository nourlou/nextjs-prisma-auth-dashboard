generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Rôles possibles : ADMIN, ENSEIGNANT, ETUDIANT
// (SQLite ne gère pas les enums : String + validation côté serveur)
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ETUDIANT")
  createdAt DateTime @default(now())
}
